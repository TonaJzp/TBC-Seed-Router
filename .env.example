# Variables de la web pública (ver «Publicar la app» en el README).
# En local no hace falta ninguna.

NODE_ENV=production
# Dirección pública https:// de la web
SITE_URL=https://tu-dominio.example
# Email público de contacto (aviso legal, privacidad e identificación ante godfat y la wiki)
CONTACT_EMAIL=tu-email-dedicado@example.com
OWNER_NAME=TonaJzp
# Quién aloja la web (aparece en la política de privacidad)
HOSTING_PROVIDER=Koyeb SAS (Francia), servidores en Fráncfort (Alemania)
# El proxy del hosting está delante: así se ve la IP real del visitante
TRUST_PROXY=1

# Límites de carga sobre bc.godfat.org
MAX_JOBS=2
MAX_QUEUE=20
RATE_LIMIT=10
RATE_WINDOW_MIN=10
# Pon false para dejar de leer godfat sin apagar la web (p. ej. si godfat lo pide)
GODFAT_ENABLED=true

# Apoyo voluntario: el enlace solo aparece si están las cuatro variables
# DONATE_URL=https://ko-fi.com/tu-usuario
# DONATE_PLATFORM=Ko-fi
# OWNER_NIF=
# OWNER_ADDRESS=
